{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64",
      "displayName": "x64 (newest installed Visual Studio)",
      "binaryDir": "${sourceDir}/build/x64",
      "architecture": { "value": "x64", "strategy": "set" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "release", "configurePreset": "x64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
